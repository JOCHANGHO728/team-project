<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 카메라 권한 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CustomerApp"
        tools:targetApi="31">
        <activity
            android:name=".Customer.BarcodeScan.BarcodeScan"
            android:exported="false" />
        <activity
            android:name=".Customer.Shoppingbasket.ShoppingBasket"
            android:exported="false" />
        <activity
            android:name=".Customer.Shoppingbasket.Payment"
            android:exported="false" />
        <activity
            android:name=".Customer.Shoppingbasket.PaymentSuccessActivity"
            android:exported="false" />
        <activity
            android:name=".Customer.Shoppingbasket.PortOnePaymentWebViewActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="customerapp" android:host="payment-callback" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Customer.Customer"
            android:exported="false" />
        <activity
            android:name=".Customer.MyInfo"
            android:exported="false" />
        <activity
            android:name=".SignUp"
            android:exported="false" />
        <activity
            android:name=".Login"
            android:exported="false" />
        <activity
            android:name=".Customer.Household_Ledger.household_Ledger"
            android:exported="false" />
        <activity
            android:name=".Customer.Household_Ledger.LedgerDetailSearchActivity"
            android:exported="false" />
        <activity
            android:name=".Customer.Household_Ledger.LedgerResultActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
