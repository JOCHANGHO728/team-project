<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".Customer.Shoppingbasket.MakeBarcode">

    <!-- 상단 타이틀 -->
    <TextView
        android:id="@+id/tv_barcode_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="40dp"
        android:text="BARCODE SCAN"
        android:textColor="#000000"
        android:textSize="24sp"
        android:textStyle="bold"
        android:lineSpacingExtra="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="40dp"
        android:background="@android:color/transparent"
        android:padding="4dp"
        android:src="@drawable/ic_arrow_back"
        android:tint="#000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- 카메라 + 스캔 영역 전체 -->
    <LinearLayout
        android:id="@+id/scan_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tv_barcode_title"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation">

        <!-- 카메라 프리뷰 + 중앙 스캔 가이드 오버레이 -->
        <FrameLayout
            android:id="@+id/scan_guide_frame"
            android:layout_width="match_parent"
            android:layout_height="308dp">

            <androidx.camera.view.PreviewView
                android:id="@+id/cameraPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:keepScreenOn="true"
                android:background="#000000"
                app:implementationMode="compatible" />

            <View
                android:id="@+id/scanGuide"
                android:layout_width="145dp"
                android:layout_height="118dp"
                android:layout_gravity="center"
                android:elevation="10dp"
                android:background="@drawable/scan_guide_box" />
        </FrameLayout>

        <!-- 안내 텍스트 -->
        <TextView
            android:id="@+id/tv_scan_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="바코드를 사각형 안에 맞춰주세요"
            android:textColor="#000000"
            android:textSize="16sp"
            android:layout_marginTop="12dp"
            android:layout_gravity="center_horizontal" />

    </LinearLayout>

    <!-- 하단 네비게이션 -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:background="#FFFFFF"
        app:elevation="8dp"
        app:itemIconSize="24dp"
        app:itemPaddingBottom="12dp"
        app:itemPaddingTop="12dp"
        app:itemIconTint="#000000"
        app:itemTextColor="#000000"
        app:itemActiveIndicatorStyle="@null"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
