<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                                   xmlns:app="http://schemas.android.com/apk/res-auto"
                                                   android:layout_width="match_parent"
                                                   android:layout_height="match_parent"
                                                   android:background="#FFFFFF">

    <android.widget.Button
            android:id="@+id/header_bar"
            android:layout_width="match_parent"
            android:layout_height="75sp"
            android:background="#6090ED"
            android:text="본인 인증"
            app:layout_constraintTop_toTopOf="parent" />

    <TextView
            android:id="@+id/tv_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="지문 인식 센서에 손가락을 올려주세요"
            android:textSize="18sp"
            android:textColor="#333333"
            app:layout_constraintTop_toBottomOf="@id/header_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="100dp" />

    <ImageView
            android:id="@+id/iv_fingerprint"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@android:drawable/ic_fingerprint"
            app:layout_constraintTop_toBottomOf="@id/tv_guide"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="50dp"
            app:tint="#6090ED" />

    <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="대기 중"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/iv_fingerprint"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <!--<android.widget.Button
            android:id="@+id/btn_cancel"
            android:layout_width="250sp"
            android:layout_height="75sp"
            android:background="@drawable/button_backgroud"
            android:text="취소하고 돌아가기"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="100dp" />-->

</androidx.constraintlayout.widget.ConstraintLayout>