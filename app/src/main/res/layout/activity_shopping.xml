<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Customer.Shopping.Shopping">

    <android.widget.Button
        android:id="@+id/blue_button"
        android:layout_width="match_parent"
        android:layout_height="75sp"
        android:background="#6090ED"
        android:text="쇼핑리스트 만들기"
        android:textSize="20sp"
        app:layout_constraintBaseline_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/categoryLayout"
        android:layout_width="375sp"
        android:layout_height="250sp"
        android:padding="16dp"
        android:background="@drawable/border_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/blue_button"
        android:layout_marginTop="24dp"
        >

        <TextView
            android:id="@+id/category"
            android:layout_width="wrap_content"
            android:layout_height="20sp"
            android:text="카테고리"
            android:textSize="15sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">
        </TextView>

        <android.widget.Button
            android:id="@+id/snack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="과자"
            android:background="@drawable/button_backgroud"
            app:layout_constraintTop_toBottomOf="@id/category"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="12dp"
            />

        <android.widget.Button
            android:id="@+id/drink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="음료"
            android:background="@drawable/button_backgroud"
            app:layout_constraintTop_toBottomOf="@id/category"
            app:layout_constraintStart_toEndOf="@id/snack"
            android:layout_marginTop="12dp"
            android:layout_marginLeft="12dp"
            >
        </android.widget.Button>

        <android.widget.Button
            android:id="@+id/noodle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="면류"
            android:background="@drawable/button_backgroud"
            app:layout_constraintTop_toBottomOf="@id/category"
            app:layout_constraintStart_toEndOf="@id/drink"
            android:layout_marginTop="12dp"
            android:layout_marginLeft="12dp"
            >
        </android.widget.Button>

        <android.widget.Button
            android:id="@+id/dairy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="유제품"
            android:background="@drawable/button_backgroud"
            app:layout_constraintTop_toBottomOf="@id/snack"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="12dp">
        </android.widget.Button>

        <android.widget.Button
            android:id="@+id/instant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="즉석 조리"
            android:background="@drawable/button_backgroud"
            app:layout_constraintTop_toBottomOf="@id/drink"
            app:layout_constraintStart_toEndOf="@id/dairy"
            android:layout_marginTop="12dp"
            android:layout_marginLeft="12dp"
            >
        </android.widget.Button>

        <android.widget.Button
            android:id="@+id/fresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="신선식품"
            android:background="@drawable/button_backgroud"
            app:layout_constraintTop_toBottomOf="@id/noodle"
            app:layout_constraintStart_toEndOf="@id/instant"
            android:layout_marginTop="12dp"
            android:layout_marginLeft="12dp"
            >
        </android.widget.Button>

        <android.widget.Button
            android:id="@+id/frozen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="냉동식품"
            android:background="@drawable/button_backgroud"
            app:layout_constraintTop_toBottomOf="@id/dairy"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="12dp">
        </android.widget.Button>

        <android.widget.Button
            android:id="@+id/household"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="가정용품"
            android:background="@drawable/button_backgroud"
            app:layout_constraintTop_toBottomOf="@id/instant"
            app:layout_constraintStart_toEndOf="@id/frozen"
            android:layout_marginTop="12dp"
            android:layout_marginLeft="12dp"
            >
        </android.widget.Button>

        <android.widget.Button
            android:id="@+id/hygiene"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="위생용품"
            android:background="@drawable/button_backgroud"
            app:layout_constraintTop_toBottomOf="@id/fresh"
            app:layout_constraintStart_toEndOf="@id/household"
            android:layout_marginTop="12dp"
            android:layout_marginLeft="12dp"
            >
        </android.widget.Button>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <android.widget.Button
        android:id="@+id/search"
        android:layout_width="250sp"
        android:layout_height="50sp"
        android:text="장바구니 조회"
        android:background="@drawable/button_backgroud"
        app:layout_constraintTop_toBottomOf="@id/categoryLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp"
        />

    <android.widget.Button
        android:id="@+id/reset"
        android:layout_width="250sp"
        android:layout_height="50sp"
        android:text="장바구니 초기화"
        android:background="@drawable/button_backgroud"
        app:layout_constraintTop_toBottomOf="@id/search"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp"
        />

    <android.widget.Button
        android:id="@+id/out"
        android:layout_width="250sp"
        android:layout_height="50sp"
        android:text="메인화면으로 돌아가기"
        android:background="@drawable/button_backgroud"
        app:layout_constraintTop_toBottomOf="@id/reset"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp"
        />

    <android.widget.Button
        android:layout_width="match_parent"
        android:layout_height="75sp"
        android:background="#6090ED"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>