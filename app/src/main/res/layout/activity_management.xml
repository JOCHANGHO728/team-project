<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".management.Management">

    <android.widget.Button
        android:id="@+id/blue_button"
        android:layout_width="match_parent"
        android:layout_height="75sp"
        android:background="#6090ED"
        android:text="매장 관리"
        app:layout_constraintBaseline_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/innerLayout"
        android:layout_width="375sp"
        android:layout_height="525sp"
        android:padding="16dp"
        android:background="@drawable/border_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/blue_button"
        android:layout_marginTop="24dp"
        >

        <android.widget.Button
            android:id="@+id/search"
            android:layout_width="300sp"
            android:layout_height="80sp"
            android:text="매장 상품조회"
            android:textSize="15sp"
            android:background="@drawable/button_backgroud"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >
        </android.widget.Button>

        <android.widget.Button
            android:id="@+id/change"
            android:layout_width="300sp"
            android:layout_height="80sp"
            android:text="매장 상품 변경"
            android:textSize="15sp"
            android:background="@drawable/button_backgroud"
            android:layout_marginTop="20sp"
            app:layout_constraintTop_toBottomOf="@+id/search"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />

        <android.widget.Button
            android:id="@+id/suggest"
            android:layout_width="300sp"
            android:layout_height="80sp"
            android:text="매장 상품 발주 추천(ai 기능)"
            android:textSize="15sp"
            android:background="@drawable/button_backgroud"
            android:layout_marginTop="20sp"
            app:layout_constraintTop_toBottomOf="@+id/change"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />

        <android.widget.Button
            android:id="@+id/logout"
            android:layout_width="300sp"
            android:layout_height="80sp"
            android:text="로그아웃"
            android:textSize="15sp"
            android:background="@drawable/button_backgroud"
            android:layout_marginTop="20sp"
            app:layout_constraintTop_toBottomOf="@+id/suggest"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <android.widget.Button
        android:id="@+id/blue_button2"
        android:layout_width="match_parent"
        android:layout_height="75sp"
        android:background="#6090ED"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>